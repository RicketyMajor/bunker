# --- API KEYS ---
GOOGLE_BOOKS_KEY="your_google_books_key_here"
TMDB_API_KEY="your_tmdb_api_key_here"
BARCODE_LOOKUP_KEY="your_barcode_lookup_key_here"
OMDB_API_KEY="your_omdb_api_key_here"
DISCOGS_API_KEY="your_discogs_api_key_here"
LASTFM_API_KEY="your_lastfm_api_key_here"
COMIC_VINE_KEY="your_comic_vine_key_here"

# --- INFRAESTRUCTURA Y SISTEMA ---
BUNKER_API_URL="http://localhost:8009"
STOCKFISH_PATH="/usr/games/stockfish"
LC0_PATH="/usr/games/lc0"
# Protege /api/backup/ y /api/restore/. Cambialo: el valor por defecto del codigo es publico.
BUNKER_BACKUP_TOKEN="cambia_este_token"

# Origin the mobile companion is served from, e.g. https://bunker.tailXXXX.ts.net
# Required for CSRF on any POST from the phone. Empty = localhost only.
BUNKER_PUBLIC_ORIGIN=

# --- DJANGO ---
# Sin valor por defecto en el codigo: el que habia esta publicado en el repositorio.
# Generala con: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
DJANGO_SECRET_KEY=
# Contrasena de Postgres. Cambiarla aqui NO rota la de una base ya inicializada:
# la imagen solo la aplica al crear el volumen. Para rotar de verdad hace falta un
# ALTER USER admin WITH PASSWORD '...' dentro del contenedor db, y luego actualizar esto.
POSTGRES_PASSWORD=cambia_esta_clave
# True filtra el diccionario settings entero (todas las claves de aqui) en cualquier 500.
DJANGO_DEBUG=False
# Obligatoria con DEBUG=False. 'web' la usan los scrapers, 'localhost' el healthcheck.
# El host de BUNKER_PUBLIC_ORIGIN se anade solo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
