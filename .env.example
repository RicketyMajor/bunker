# --- API KEYS ---
GOOGLE_BOOKS_KEY="your_google_books_key_here"
TMDB_API_KEY="your_tmdb_api_key_here"
BARCODE_LOOKUP_KEY="your_barcode_lookup_key_here"
OMDB_API_KEY="your_omdb_api_key_here"
DISCOGS_API_KEY="your_discogs_api_key_here"
LASTFM_API_KEY="your_lastfm_api_key_here"
COMIC_VINE_KEY="your_comic_vine_key_here"

# --- INFRASTRUCTURE AND SYSTEM ---
BUNKER_API_URL="http://localhost:8009"
STOCKFISH_PATH="/usr/games/stockfish"
LC0_PATH="/usr/games/lc0"
# Guards /api/backup/ and /api/restore/. Leave it EMPTY, for the same reason as
# POSTGRES_PASSWORD below: bunker_core/views.py:43-46 fails CLOSED — an unset token answers 503
# ("BUNKER_BACKUP_TOKEN no esta configurado en el servidor") and serves nobody. A filler value
# does not fail; it works, and it is a token published in this file guarding a full database
# dump. There is no default in the code any more, so empty is safe and loud.
BUNKER_BACKUP_TOKEN=

# Origin the mobile companion is served from, e.g. https://bunker.tailXXXX.ts.net
# Required for CSRF on any POST from the phone. Empty = localhost only.
# MUST include the scheme: without it urlparse().hostname is None, the ALLOWED_HOSTS append is
# skipped in silence, and it surfaces later as a CSRF (4_0.E001). settings.py refuses it now.
BUNKER_PUBLIC_ORIGIN=

# --- DJANGO ---
# No default in the code: the one that used to be there is published in the repository.
# Generate it with: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
DJANGO_SECRET_KEY=
# Postgres password. Changing it here does NOT rotate an already-initialised database: the image
# only applies it when creating the volume. A real rotation needs an
# ALTER USER admin WITH PASSWORD '...' inside the db container, and then updating this.
#
# Leave it EMPTY: `${POSTGRES_PASSWORD:?}` in docker-compose.yml fails loudly, which is what is
# wanted. A filler value looks like it works and does not: over an existing volume the role keeps
# its own password, `pg_isready -U admin -d library_db` uses none and reports `healthy`, `web`
# starts on `service_healthy`, and every Django query dies with `password authentication failed`
# — a late failure, far from its cause.
POSTGRES_PASSWORD=
# True does NOT leak the settings dictionary: Django masks 24 values, SECRET_KEY among them, and
# the API keys live in os.environ, not in settings. What it does leak are the traceback's FRAME
# LOCALS (bunker_core/views.py:43), which is how a 50 KB 500 escaped. Checking "are my keys in
# settings?" and concluding DEBUG=True is safe is the mistake this comment exists to prevent.
DJANGO_DEBUG=False
# Required with DEBUG=False. 'web' is what the scrapers use, 'localhost' the healthcheck.
# The host from BUNKER_PUBLIC_ORIGIN is appended automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
